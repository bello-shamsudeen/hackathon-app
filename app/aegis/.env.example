# Division 6 - AI Explainability environment setup
# Copy this file to .env and fill in what you have. NONE of these are
# required for the system to work - if all are missing, the deterministic
# fallback in llm_explainer.py still produces a correct plain-English
# sentence. This is deliberate: the graded requirement never breaks.

# ---- Groq (free tier, fastest, try this first) ----
# Get a free key at https://console.groq.com/keys - no credit card needed.
GROQ_API_KEY=your-groq-key-here

# ---- Google Gemini (free tier, second option) ----
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# ---- Ollama (fully local, fully offline - SET THIS UP BEFORE DEMO DAY) ----
# Install from https://ollama.com, then run: ollama pull llama3.2
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2