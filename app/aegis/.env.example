# Division 6 — LLM explanation providers. Copy to .env and fill in.
# The real .env is gitignored; only this template is committed.

# Groq (free tier, fastest) — optional. Left blank in dev; chain skips it.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Google Gemini (free tier) — the primary cloud provider in this build.
GEMINI_API_KEY=
# gemini-1.5-flash was retired; this stable alias always points at current Flash.
GEMINI_MODEL=gemini-flash-latest

# Ollama (local, fully offline) — the demo-day safety net. From inside the
# backend container the host is reachable as host.docker.internal (compose
# overrides this value); on the host itself use localhost.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Timeouts (seconds). The /bank/transfer hot path passes its own tight bounds
# and never blocks on these; they apply to the copilot / incident-report /
# on-demand explain endpoints.
LLM_CLOUD_TIMEOUT=15
OLLAMA_TIMEOUT=60
